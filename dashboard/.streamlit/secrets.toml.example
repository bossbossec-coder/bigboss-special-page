# Streamlit Community Cloudで「Settings → Secrets」に貼り付ける内容の見本です。
# このファイル自体はコピー用のサンプルなので、実際の値は書き込まないでください
# （本物の値を書いた secrets.toml は .gitignore で除外されています）。

# ダッシュボード全体の閲覧に必要なパスワード（店長さんなどに共有する合言葉）。
# 設定しなければ、これまで通りパスワード無しで誰でも閲覧できる状態のままです。
viewer_password = "ここに店長さんたちに共有する合言葉を設定"

# ダッシュボードの「データ登録」欄を開くためのパスワード（好きな文字列でOK）
admin_password = "ここに好きなパスワードを設定"

# アップロードしたExcelを保存しに行くGitHubリポジトリの情報
# 個人アクセストークンの作り方は使い方ガイドを参照してください
github_token = "ここにGitHubの個人アクセストークンを貼り付け"
github_repo = "bossbossec-coder/bigboss-special-page"
github_branch = "claude/multi-store-sales-dashboard-4kty7j"

# ダッシュボード下部に表示するGoogleカレンダーの埋め込みURL。
# Googleカレンダーの「設定と共有」→「予定表の統合」にある埋め込みコードの
# src="..." の中身（https://calendar.google.com/calendar/embed?src=... の部分）
# をそのまま貼り付けてください。設定しなければ予定表は表示されません。
google_calendar_src = "ここにGoogleカレンダーの埋め込みURLを貼り付け"
